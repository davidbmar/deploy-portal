# AWS Configuration Template
# Copy this file to ~/.ec2-config.env and fill in your values
#
# IMPORTANT: This file does NOT contain AWS access keys or secrets.
# AWS credentials are provided by an IAM role attached to your EC2 instance.
#
# See: https://docs.aws.amazon.com/IAM/latest/UserGuide/id_roles_use_switch-role-ec2.html

# AWS Region (must match your EC2 instance region)
# Examples: us-east-1, us-west-2, eu-west-1
export AWS_REGION=us-east-1

# AWS Security Group ID to manage
# Format: sg-xxxxxxxxxxxxxxxxx
# Find via: aws ec2 describe-security-groups --region us-east-1
export SECURITY_GROUP_ID=sg-0123456789abcdef0

# Public IP address of THIS server
# Auto-detected by: curl http://169.254.169.254/latest/meta-data/public-ipv4
export PUBLIC_IP=1.2.3.4

# SSH Key Configuration (optional, for deploying to other servers)
# Path to your SSH private key file (.pem)
export SSH_KEY_PATH=/home/ubuntu/.ssh/deploy-key.pem
export SSH_KEY_NAME=deploy-key

# AWS Cognito Configuration (optional, for OAuth2 authentication)
# Leave empty if not using Cognito
export COGNITO_POOL_ID=us-east-1_XXXXXXXXX
export COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
export COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
export COGNITO_REGION=us-east-1
export COGNITO_DOMAIN=your-cognito-domain

# OAuth2 Proxy Port (default)
export OAUTH2_PORT=4180

# Usage:
# 1. Copy this file: cp .ec2-config.env.example ~/.ec2-config.env
# 2. Edit with your values: nano ~/.ec2-config.env
# 3. Set secure permissions: chmod 600 ~/.ec2-config.env
# 4. Source in scripts: source ~/.ec2-config.env
# 5. Add to systemd: EnvironmentFile=/home/ubuntu/.ec2-config.env
