[Unit]
Description={{APP_NAME}} - Deployed via Deploy Portal
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/deployments/{{APP_NAME}}
ExecStart={{START_COMMAND}}
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment variables
Environment=PORT={{PORT}}
Environment=NODE_ENV=production
Environment=PYTHONUNBUFFERED=1

# Security Hardening
NoNewPrivileges=true
PrivateTmp=true

# Seccomp syscall filtering
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @module @raw-io @reboot @swap @obsolete @debug
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes

# Additional restrictions
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/deployments/{{APP_NAME}}
ReadWritePaths=/tmp
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Capabilities
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
