# Deploy Portal Configuration
# Copy this file to config.env and fill in your values

# AWS Configuration
export AWS_REGION=us-east-1
export SECURITY_GROUP_ID=sg-0d6bbadbbd290b320

# SSH Configuration
export SSH_KEY_NAME=deploy-key

# Deployment Configuration
export DEPLOYMENT_ROOT=/home/ubuntu/deployments
export PORT_RANGE_START=5001
export PORT_RANGE_END=5999

# Flask Configuration
export FLASK_SECRET_KEY=$(openssl rand -hex 32)
export FLASK_PORT=5000

# Activity Log Configuration
export ACTIVITY_LOG_DIR=/var/log/deploy-sessions
