# Authentication Gateway Configuration for 52.43.35.1
# Protects both Website Cloner (port 3000) and SSH Terminal (port 8080)
# Authentication handled by oauth2-proxy (port 4180)

upstream oauth2_proxy {
    server 127.0.0.1:4180;
}

upstream ssh_terminal {
    server 127.0.0.1:8080;
}

upstream website_cloner {
    server 127.0.0.1:3000;
}

upstream deploy_portal {
    server 127.0.0.1:5000;
}

# Include app-specific upstreams (for deployed applications)
include /etc/nginx/conf.d/upstreams/*.conf;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;

    ssl_certificate /etc/nginx/ssl/selfsigned.crt;
    ssl_certificate_key /etc/nginx/ssl/selfsigned.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    server_name 52.43.35.1;

    # OAuth2 Proxy endpoints (public, no auth required)
    location /oauth2/ {
        proxy_pass http://oauth2_proxy;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Scheme $scheme;
        proxy_set_header X-Auth-Request-Redirect $request_uri;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Cookie handling - ensure cookies are passed through
        proxy_set_header Cookie $http_cookie;
        proxy_pass_request_headers on;

        # Buffer settings for OAuth flow
        proxy_buffer_size 16k;
        proxy_buffers 8 64k;
        proxy_busy_buffers_size 128k;
        proxy_redirect default;
    }

    # Static files for deploy portal (no auth needed for CSS/JS)
    location /deploy/static/ {
        alias /home/ubuntu/src/deploy-portal/static/;
        expires 1h;
        add_header Cache-Control "public, immutable";
    }

    # Include app-specific location blocks (for deployed applications)
    include /etc/nginx/conf.d/apps/*.conf;

    # Protected: Deploy Portal (root page)
    location / {
        # Authentication check
        auth_request /oauth2/auth;
        error_page 401 = /oauth2/start?rd=$scheme://$host$request_uri;

        # Pass authentication headers from oauth2-proxy to backend
        auth_request_set $user $upstream_http_x_auth_request_user;
        auth_request_set $email $upstream_http_x_auth_request_email;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie;

        # Proxy to deploy portal application
        proxy_pass http://deploy_portal;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Pass authenticated user info to backend
        proxy_set_header X-User-Email $email;
        proxy_set_header X-Auth-Request-User $user;

        # WebSocket support for terminal
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }

    # Protected: Website Cloner
    location /cloner/ {
        # Authentication check
        auth_request /oauth2/auth;
        error_page 401 = /oauth2/start?rd=$scheme://$host$request_uri;

        # Pass authentication headers from oauth2-proxy to backend
        auth_request_set $user $upstream_http_x_auth_request_user;
        auth_request_set $email $upstream_http_x_auth_request_email;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie;

        # Rewrite /cloner/ to / for the backend
        rewrite ^/cloner/(.*)$ /$1 break;

        # Proxy to website cloner application
        proxy_pass http://website_cloner;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Pass authenticated user info to backend
        proxy_set_header X-User-Email $email;
        proxy_set_header X-Auth-Request-User $user;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }

    # Redirect /cloner (without trailing slash) to /cloner/
    location = /cloner {
        return 301 /cloner/;
    }

    # Protected: SSH Terminal (at /ssh/)
    location /ssh/ {
        auth_request /oauth2/auth;
        error_page 401 = /oauth2/start?rd=$scheme://$host$request_uri;

        auth_request_set $user $upstream_http_x_auth_request_user;
        auth_request_set $email $upstream_http_x_auth_request_email;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie;

        rewrite ^/ssh/(.*)$ /$1 break;

        proxy_pass http://ssh_terminal;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header X-User-Email $email;
        proxy_set_header X-Auth-Request-User $user;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }

    location = /ssh {
        return 301 /ssh/;
    }

    # Protected: SSH Terminal (at /terminal/ - alias)
    location /terminal/ {
        auth_request /oauth2/auth;
        error_page 401 = /oauth2/start?rd=$scheme://$host$request_uri;

        auth_request_set $user $upstream_http_x_auth_request_user;
        auth_request_set $email $upstream_http_x_auth_request_email;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie;

        rewrite ^/terminal/(.*)$ /$1 break;

        proxy_pass http://ssh_terminal;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header X-User-Email $email;
        proxy_set_header X-Auth-Request-User $user;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }

    location = /terminal {
        return 301 /terminal/;
    }

    # Health check endpoint (no auth required)
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}
