# Deploy Portal EC2 Configuration Template
#
# Copy this to /home/ubuntu/.ec2-config.env on the target server
# and fill in the appropriate values for your deployment.

# ========================================
# AWS Cognito Configuration
# ========================================
# These values come from your AWS Cognito User Pool
export COGNITO_POOL_ID={{COGNITO_POOL_ID}}
export COGNITO_CLIENT_ID={{COGNITO_CLIENT_ID}}
export COGNITO_CLIENT_SECRET={{COGNITO_CLIENT_SECRET}}
export COGNITO_REGION={{COGNITO_REGION}}
export COGNITO_DOMAIN={{COGNITO_DOMAIN}}

# ========================================
# AWS Configuration
# ========================================
# AWS region where this EC2 instance is running
export AWS_REGION={{AWS_REGION}}

# Security group ID for this instance
export SECURITY_GROUP_ID={{SECURITY_GROUP_ID}}

# Public IP address of this server
export PUBLIC_IP={{PUBLIC_IP}}

# ========================================
# SSH Key Configuration
# ========================================
# Path to the SSH private key used for deployment kit distribution
# This key will be included in deployment kits downloaded by users
export SSH_KEY_PATH={{SSH_KEY_PATH}}

# Name of the SSH key (without .pem extension)
# This should match the key name in AWS EC2
export SSH_KEY_NAME={{SSH_KEY_NAME}}

# ========================================
# Portal Configuration
# ========================================
# OAuth2 Proxy port (default: 4180)
export OAUTH2_PORT=4180

# Domain name for this portal instance
# Used for generating callback URLs and display
export INSTANCE_DOMAIN={{INSTANCE_DOMAIN}}

# ========================================
